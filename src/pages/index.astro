---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getParentSession } from '../lib/auth';

const parent = await getParentSession(Astro.cookies);
---

<BaseLayout>
  <Fragment slot="nav">
    {parent ? (
      <>
        <a class="btn btn-secondary btn-small" href="/admin">Admin</a>
        <a class="btn btn-ghost btn-small" href="/auth/logout">Log out</a>
      </>
    ) : (
      <a class="btn btn-primary btn-small" href="/auth/google">Login with Google</a>
    )}
  </Fragment>

  <section class="hero">
    <div class="hero-copy">
      <h1>Allowance, without the spreadsheet stress.</h1>
      <p class="lede">
        Parents manage balances. Kids check the family page. Sunday adds the weekly allowance
        automatically.
      </p>
      <div class="row">
        {parent ? (
          <a class="btn btn-primary" href="/admin">Open your family admin</a>
        ) : (
          <a class="btn btn-primary" href="/auth/google">Login with Google</a>
        )}
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="coin one"></div>
      <div class="coin two"></div>
      <div class="coin three"></div>
    </div>
  </section>

  <section class="features">
    <div class="feature">
      <h3>Parent admin</h3>
      <p>Add kids, set weekly amounts, and jot memo lines when you add or deduct money.</p>
    </div>
    <div class="feature">
      <h3>Family home</h3>
      <p>Share a short private URL. One family password unlocks everyone’s totals.</p>
    </div>
    <div class="feature">
      <h3>Sunday autopay</h3>
      <p>A scheduled job credits allowance each week and skips duplicates if it runs twice.</p>
    </div>
  </section>
</BaseLayout>
