---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireParentUser, siteUrl } from '../../lib/auth';
import { getKidsWithBalances } from '../../lib/data';
import { formatMoney } from '../../lib/money';

const user = await requireParentUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/auth/google');
}

const kids = await getKidsWithBalances(user.id);
const flash = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const familyUrl = `${siteUrl()}/f/${user.familySlug}`;
const hasPassword = Boolean(user.familyPasswordHash);
---

<BaseLayout title="Family Admin · My Family Allowance">
  <Fragment slot="nav">
    <a class="btn btn-ghost btn-small" href="/">Home</a>
    <a class="btn btn-ghost btn-small" href="/auth/logout">Log out</a>
  </Fragment>

  <section style="padding: 1rem 0 2.5rem">
    <h1>Family admin</h1>
    <p>Signed in as {user.name} ({user.email}).</p>

    {flash && <div class="flash flash-ok">{flash}</div>}
    {error && <div class="flash flash-err">{error}</div>}

    <div class="panel">
      <h2>Family page</h2>
      <p class="meta">Share this URL with your kids. They’ll need the family password.</p>
      <div class="family-url-row">
        <a class="family-url" href={familyUrl} target="_blank" rel="noopener noreferrer">{familyUrl}</a>
        <button
          type="button"
          class="family-url-copy"
          data-url={familyUrl}
          aria-label="Copy URL"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="family-url-copied" aria-hidden="true">Copied!</span>
        </button>
      </div>

      <form class="form-grid" method="POST" action="/api/admin/family-password" style="margin-top:1rem">
        <label>
          {hasPassword ? 'Change family password' : 'Set family password'}
          <input
            type="password"
            name="password"
            required
            minlength="4"
            maxlength="72"
            autocomplete="new-password"
            placeholder="At least 4 characters"
          />
        </label>
        <button class="btn btn-primary" type="submit">
          {hasPassword ? 'Update password' : 'Save password'}
        </button>
      </form>
    </div>

    <div class="panel">
      <h2>Kids</h2>
      {kids.length === 0 ? (
        <p class="muted">No kids yet. Add one below to get started.</p>
      ) : (
        <div class="kid-list">
          {kids.map((kid) => (
            <article class="kid-card">
              <div>
                <h3>{kid.name}</h3>
                <div class:list={['balance', { neg: kid.balanceCents < 0 }]}>
                  {formatMoney(kid.balanceCents)}
                </div>
                <p class="meta">
                  Weekly: {formatMoney(kid.weeklyAllowanceCents)} ·
                  <a href={`/f/${user.familySlug}/kid/${kid.id}`}>View history</a>
                </p>
              </div>
              <div class="stack">
                <details class="inline-form">
                  <summary>Add / deduct</summary>
                  <form class="form-grid" method="POST" action="/api/admin/transactions" style="margin-top:0.75rem">
                    <input type="hidden" name="kidId" value={kid.id} />
                    <label>
                      Amount ($) — positive adds, negative deducts
                      <input type="number" name="amount" required step="0.01" placeholder="5.00" />
                    </label>
                    <label>
                      Memo
                      <input type="text" name="memo" maxlength="200" placeholder="Chores bonus" />
                    </label>
                    <button class="btn btn-secondary btn-small" type="submit">Save transaction</button>
                  </form>
                </details>

                <details class="inline-form">
                  <summary>Edit kid</summary>
                  <form class="form-grid" method="POST" action={`/api/admin/kids/${kid.id}`} style="margin-top:0.75rem">
                    <input type="hidden" name="_method" value="PATCH" />
                    <label>
                      Name
                      <input type="text" name="name" required maxlength="80" value={kid.name} />
                    </label>
                    <label>
                      Weekly allowance ($)
                      <input
                        type="number"
                        name="weeklyAllowance"
                        required
                        min="0"
                        step="0.01"
                        value={(kid.weeklyAllowanceCents / 100).toFixed(2)}
                      />
                    </label>
                    <button class="btn btn-secondary btn-small" type="submit">Save changes</button>
                  </form>
                </details>

                <form
                  method="POST"
                  action={`/api/admin/kids/${kid.id}`}
                  onsubmit="return confirm('Delete this kid and all of their transactions?');"
                >
                  <input type="hidden" name="_method" value="DELETE" />
                  <button class="btn btn-danger btn-small" type="submit">Delete</button>
                </form>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>

    <div class="panel">
      <h2>Add a kid</h2>
      <form class="form-grid two" method="POST" action="/api/admin/kids">
        <label>
          Name
          <input type="text" name="name" required maxlength="80" placeholder="Alex" />
        </label>
        <label>
          Weekly allowance ($)
          <input
            type="number"
            name="weeklyAllowance"
            required
            min="0"
            step="0.01"
            placeholder="10.00"
          />
        </label>
        <div class="row">
          <button class="btn btn-primary" type="submit">Add kid</button>
        </div>
      </form>
    </div>
  </section>

  <script>
    document.querySelector('.family-url-copy')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget;
      if (!(btn instanceof HTMLButtonElement)) return;
      const url = btn.dataset.url;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        btn.setAttribute('aria-label', 'Copied!');
        btn.classList.add('is-copied');
        setTimeout(() => {
          btn.setAttribute('aria-label', 'Copy URL');
          btn.classList.remove('is-copied');
        }, 1500);
      } catch {
        // Clipboard API unavailable or denied
      }
    });
  </script>
</BaseLayout>
