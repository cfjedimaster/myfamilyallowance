---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { requireFamilyAccess, siteUrl } from '../../../lib/auth';
import { getKidsWithBalances } from '../../../lib/data';
import { formatMoney } from '../../../lib/money';
import { db } from '../../../../db';
import { users } from '../../../../db/schema';
import { eq } from 'drizzle-orm';

const slug = Astro.params.slug;
if (!slug || !/^[a-z0-9]{5}$/.test(slug)) {
  return Astro.redirect('/');
}

const [family] = await db.select().from(users).where(eq(users.familySlug, slug)).limit(1);
if (!family) {
  return Astro.redirect('/');
}

const owner = await requireFamilyAccess(Astro.cookies, slug);
const error = Astro.url.searchParams.get('error');

let kids: Awaited<ReturnType<typeof getKidsWithBalances>> = [];
if (owner) {
  kids = await getKidsWithBalances(owner.id);
}

const familyUrl = `${siteUrl()}/f/${slug}`;
---

<BaseLayout title="Family totals · My Family Allowance">
  <Fragment slot="nav">
    {owner && (
      <form method="POST" action={`/api/family/${slug}/logout`}>
        <button class="btn btn-ghost btn-small" type="submit" aria-label="Lock" title="Logout">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </button>
      </form>
    )}
  </Fragment>

  <section style="padding: 1rem 0 2.5rem">
    <h1>Family totals</h1>
    <p class="meta">{familyUrl}</p>

    {error && <div class="flash flash-err">{error}</div>}

    {!owner ? (
      <div class="panel" style="max-width:420px">
        <h2>Enter family password</h2>
        <p>Ask a parent if you don’t know it.</p>
        <form class="form-grid" method="POST" action={`/api/family/${slug}/login`}>
          <label>
            Password
            <input type="password" name="password" required autocomplete="current-password" />
          </label>
          <button class="btn btn-primary" type="submit">Unlock</button>
        </form>
      </div>
    ) : kids.length === 0 ? (
      <div class="panel">
        <p class="muted">No kids have been added yet.</p>
      </div>
    ) : (
      <div class="kid-list">
        {kids.map((kid) => (
          <a class="kid-card" href={`/f/${slug}/kid/${kid.id}`} style="text-decoration:none;color:inherit">
            <div>
              <h3>{kid.name}</h3>
              <p class="meta">Weekly allowance {formatMoney(kid.weeklyAllowanceCents)}</p>
            </div>
            <div class:list={['balance', { neg: kid.balanceCents < 0 }]}>
              {formatMoney(kid.balanceCents)}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
