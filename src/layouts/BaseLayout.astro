---
interface Props {
  title?: string;
  description?: string;
  showLegalLinks?: boolean;
}

const {
  title = 'My Family Allowance',
  description = 'Track kids’ allowance, chores bonuses, and spending in one simple family ledger.',
  showLegalLinks = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">My Family <span>Allowance</span></a>
        <nav class="nav-actions">
          <slot name="nav" />
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Built for families who want a light, shared money tracker.
          Created by <a href="https://www.raymondcamden.com">Raymond Camden</a>.
          Source Available on <a href="https://github.com/cfjedimaster/myfamilyallowance">GitHub</a>
        </p>
        {showLegalLinks && (
          <p class="footer-legal">
            <a href="/privacy">Privacy Policy</a>
            <span aria-hidden="true">·</span>
            <a href="/terms">Terms of Use</a>
          </p>
        )}
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
